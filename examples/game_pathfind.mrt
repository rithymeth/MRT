// Grid pathfinding with A*, from MRT source.
//
// game* is an engine extension: only the Rust engines have these builtins.
// See "Engine extensions" in docs/LANGUAGE_SPEC.md.
//
// gamePathfind takes a grid of true/false cells -- walkable or not -- the
// same array-of-rows shape gameDrawTilemap already reads a tile sheet in,
// and finds the shortest route between two of them. It earns a place as a
// built-in for the reason gameSweep does and gameOverlap's own four-line
// arithmetic does not: finding a shortest route needs a priority queue and
// a record of the cheapest way found to each cell so far, not four lines a
// program can write itself.

var CELL = 14;

// # is a wall, . is open floor -- the same character-map convention
// game_raycast.mrt uses for its maze.
var MAP = [
    "..........",
    ".####.###.",
    ".#........",
    ".#.######.",
    ".#.#....#.",
    ".#.#.##.#.",
    ".#.#.##.#.",
    ".#.#....#.",
    ".#######..",
    ".........."
];

func gridFromMap(map) {
    var rows = [];
    for (line in map) {
        var row = [];
        for (var x = 0; x < len(line); x = x + 1) {
            push(row, line[x] == ".");
        }
        push(rows, row);
    }
    return rows;
}

func main() {
    var grid = gridFromMap(MAP);
    var width = len(MAP[0]);
    var height = len(MAP);

    gameInit(width * CELL, height * CELL, "MRT Pathfinding");

    var floorColor = gameColor(30, 30, 45);
    var wallColor = gameColor(90, 90, 115);
    var pathColor = gameColor(230, 195, 60);

    for (var y = 0; y < height; y = y + 1) {
        for (var x = 0; x < width; x = x + 1) {
            var cellColor = wallColor;
            if (grid[y][x]) { cellColor = floorColor; }
            gameRect(x * CELL, y * CELL, CELL, CELL, cellColor);
        }
    }

    // The shortest route from the top-left corner to the bottom-right one.
    var route = gamePathfind(grid, 0, 0, width - 1, height - 1);
    print("a route exists:", route != null);
    print("its length:", len(route));

    for (point in route) {
        gameRect(point.x * CELL + 3, point.y * CELL + 3, CELL - 6, CELL - 6, pathColor);
    }

    // Every step moves to an orthogonal neighbour of the last -- no
    // diagonal shortcuts and no jump lands two cells away.
    var eachStepIsAdjacent = true;
    for (var i = 1; i < len(route); i = i + 1) {
        var dx = route[i].x - route[i - 1].x;
        var dy = route[i].y - route[i - 1].y;
        if (abs(dx) + abs(dy) != 1) { eachStepIsAdjacent = false; }
    }
    print("every step moves exactly one cell:", eachStepIsAdjacent);

    // A goal walled off entirely has no route -- an ordinary answer, null,
    // not an error.
    var sealed = [
        [true, false, true],
        [true, false, true],
        [true, false, true]
    ];
    print("a sealed-off goal has no route:", gamePathfind(sealed, 0, 0, 2, 0) == null);

    // Asking about a wall itself is the same ordinary null -- the wall is
    // inside the grid, just not walkable.
    print("asking from a wall itself is also null, not an error:",
          gamePathfind(sealed, 1, 0, 0, 0) == null);

    // A coordinate outside the grid entirely is a different case: almost
    // certainly a typo, so it is refused by name rather than answered.
    try {
        gamePathfind(grid, width, 0, 0, 0);
    } catch (e) {
        print("a start outside the grid is refused:", e.kind);
    }

    gameSave("game_pathfind.png");
    print("wrote game_pathfind.png");
}
